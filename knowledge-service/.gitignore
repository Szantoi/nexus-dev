# Runtime data - NEVER commit these
data/
*.db
*.db-shm
*.db-wal

# Runtime state files
pending-retries.json
.mcp-tokens

# Logs
logs/
*.log

# Node
node_modules/
dist/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment — every runtime env variant is ignored; only *.example templates
# (e.g. .env.example, .env.dev.example) are version-controlled
.env
.env.*
!.env.example
!.env.*.example

# Test coverage
coverage/
.nyc_output/
