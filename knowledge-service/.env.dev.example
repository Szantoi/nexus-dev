# ── NEXUS-DEV environment template ────────────────────────────────────────────
# Copy this file to `.env.dev` to run the DEV server locally:
#
#   POSIX:      cp knowledge-service/.env.dev.example knowledge-service/.env.dev
#   PowerShell: Copy-Item knowledge-service\.env.dev.example knowledge-service\.env.dev
#
# The real `.env.dev` is a runtime file: it is git-ignored and must NEVER be
# committed. Only this *.example template is version-controlled.
# No secrets belong in this template — real tokens go into your local .env.dev.

NODE_ENV=development

# DEV port 3466 — does not clash with production (3456)
PORT=3466

# Loopback only. Never bind DEV to a public interface.
HOST=127.0.0.1

# Explicit local-only development exception (code default is `required`).
# Never copy AUTH_MODE=open to a network-exposed environment.
AUTH_MODE=open

# Data directory: defaults to knowledge-service/data (cross-platform).
# For a Linux prod-like run set it explicitly:
# DATA_DIR=/opt/nexus-dev/knowledge-service/data

# Dev-specific verbose logging
LOG_LEVEL=debug

# ChromaDB — shared local instance (read-only style usage in DEV)
CHROMA_URL=http://localhost:8001

# Telegram OFF in DEV (must not send messages)
ENABLE_TELEGRAM_COORDINATOR=false
ENABLE_MULTI_BOT=false

# Automatic pipelines OFF in DEV
ENABLE_NIGHTWATCH=false
ENABLE_AUTO_RESTART=false
ENABLE_MESSAGE_ROUTER=false

# Inbox watcher OFF in DEV (must not start sessions)
ENABLE_INBOX_WATCHER=false
