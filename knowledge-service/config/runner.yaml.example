# runner.yaml — provider-neutral autonomous runner template
#
# Copy to runner.yaml (gitignored). Prefer RUNNER_TOKEN for the secret.
# The runner opens outbound connections only and is the sole CLI launch point.

server_url: http://localhost:3466
# token: "set RUNNER_TOKEN instead"

poll_interval_ms: 5000
sse_enabled: true
max_backoff_ms: 300000
max_attempts: 3
retry_cooldown_ms: 600000
# On a missing or corrupt state file, record every current UNREAD task as a
# non-launchable baseline before polling. Keep true for production.
quarantine_existing_on_first_start: true

# Lifecycle/resource guards.
session_timeout_ms: 3600000
max_output_bytes: 10485760
# Total shutdown budget (default 20000, max 120000). Startup validates it
# against the sink's minimumShutdownGraceMs(): an attached terminal requires
# spawnDeadline + cleanupDeadline + margin = 47000 ms with the defaults, so
# raise this to at least 47000 before enabling any attached-mode terminal.
shutdown_grace_ms: 20000

# Name used in generated MCP tool names: mcp__<name>__fetch_task, etc.
mcp_server_name: spaceos-knowledge

# Codex is the recommended primary provider for autonomous execution.
default_provider: codex
providers:
  codex:
    # Use an absolute binary path in systemd when Codex is outside its PATH.
    binary: codex
    # Environment variable referenced by the Codex MCP config. Each child gets
    # a terminal-specific value copied from its credential_env source.
    auth_env_var: NEXUS_AGENT_TOKEN
    sandbox: workspace-write
    ephemeral: true
    skip_git_repo_check: true
    # Headless MCP calls cannot open an approval prompt. The sandbox and
    # terminal-scoped server authorization remain the enforcement boundary.
    extra_args:
      - '-c'
      - 'approval_policy="never"'
      - '-c'
      - 'mcp_servers.spaceos-knowledge.default_tools_approval_mode="approve"'
  claude:
    binary: claude
    sandbox: workspace-write
    ephemeral: true
    extra_args: []
    max_turns: 40
    max_budget_usd: 10
  antigravity:
    binary: agy
    sandbox: workspace-write
    ephemeral: true
    extra_args: []

log_dir: logs/runner

# REQUIRED whenever any terminal uses mode: attached. Scopes completion-
# receipt validation and the durable cursor namespace; a rotated credential
# can never silently inherit another island's cursor.
# expected_island_id: island-a

# Runtime guards for attached terminals (defaults shown; all bounded).
# attached_defaults:
#   startup_timeout_ms: 30000       # PTY must prove ready within this
#   ready_confirm_samples: 2        # consecutive ready-prompt samples
#   idle_settle_ms: 1500            # quiet time before idle counts
#   idle_confirm_samples: 2         # consecutive idle samples (2..10)
#   completion_idle_timeout_ms: 30000  # receipt -> stable idle deadline
#   task_stall_timeout_ms: 600000   # busy silence before ONE audited warning
#   cols: 120
#   rows: 36

# Only listed terminals can execute on this host. Network task metadata can
# request a model only from that terminal's local allowlist.
#
# Per-terminal `mode` selects the execution model (default: headless):
#   headless  today's autonomous one-shot CLI session (detached process,
#             prompt via stdin, no live terminal). This is backward-compatible.
#   attached  a live node-pty session (Codex only for now; other providers
#             fail startup closed). Requires expected_island_id, a per-terminal
#             credential_env, and shutdown_grace_ms >= 47000. Optional
#             per-terminal classifier overrides (tuned by the PoC canary):
#               attached:
#                 ready_pattern: '[>›❯]\s*$'
#                 idle_pattern: '[>›❯]\s*$'
terminals:
  conductor:
    workdir: /opt/nexus/terminals/conductor
    provider: codex
    mode: headless
    models: [gpt-5.6-terra]
    default_model: gpt-5.6-terra
    credential_env: NEXUS_AGENT_TOKEN_CONDUCTOR
    additional_write_dirs:
      - /opt/nexus/src/nexus-core
  backend:
    workdir: /opt/nexus/terminals/backend
    provider: codex
    models: [gpt-5.6-terra]
    default_model: gpt-5.6-terra
    credential_env: NEXUS_AGENT_TOKEN_BACKEND
    additional_write_dirs:
      - /opt/nexus/src/nexus-core
