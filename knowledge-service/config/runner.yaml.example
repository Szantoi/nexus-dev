# runner.yaml — provider-neutral autonomous runner template
#
# Copy to runner.yaml (gitignored). Prefer RUNNER_TOKEN for the secret.
# The runner opens outbound connections only and is the sole CLI launch point.

server_url: http://localhost:3466
# token: "set RUNNER_TOKEN instead"

poll_interval_ms: 5000
sse_enabled: true
max_backoff_ms: 300000
max_attempts: 3
retry_cooldown_ms: 600000
# On a missing or corrupt state file, record every current UNREAD task as a
# non-launchable baseline before polling. Keep true for production.
quarantine_existing_on_first_start: true

# Lifecycle/resource guards.
session_timeout_ms: 3600000
max_output_bytes: 10485760
shutdown_grace_ms: 10000

# Name used in generated MCP tool names: mcp__<name>__fetch_task, etc.
mcp_server_name: spaceos-knowledge

# Codex is the recommended primary provider for autonomous execution.
default_provider: codex
providers:
  codex:
    # Use an absolute binary path in systemd when Codex is outside its PATH.
    binary: codex
    # Environment variable referenced by the Codex MCP config. Each child gets
    # a terminal-specific value copied from its credential_env source.
    auth_env_var: NEXUS_AGENT_TOKEN
    sandbox: workspace-write
    ephemeral: true
    skip_git_repo_check: true
    # Headless MCP calls cannot open an approval prompt. The sandbox and
    # terminal-scoped server authorization remain the enforcement boundary.
    extra_args:
      - '-c'
      - 'approval_policy="never"'
      - '-c'
      - 'mcp_servers.spaceos-knowledge.default_tools_approval_mode="approve"'
  claude:
    binary: claude
    sandbox: workspace-write
    ephemeral: true
    extra_args: []
    max_turns: 40
    max_budget_usd: 10
  antigravity:
    binary: agy
    sandbox: workspace-write
    ephemeral: true
    extra_args: []

log_dir: logs/runner

# Only listed terminals can execute on this host. Network task metadata can
# request a model only from that terminal's local allowlist.
terminals:
  conductor:
    workdir: /opt/nexus/terminals/conductor
    provider: codex
    models: [gpt-5.6-terra]
    default_model: gpt-5.6-terra
    credential_env: NEXUS_AGENT_TOKEN_CONDUCTOR
    additional_write_dirs:
      - /opt/nexus/src/nexus-core
  backend:
    workdir: /opt/nexus/terminals/backend
    provider: codex
    models: [gpt-5.6-terra]
    default_model: gpt-5.6-terra
    credential_env: NEXUS_AGENT_TOKEN_BACKEND
    additional_write_dirs:
      - /opt/nexus/src/nexus-core
