# ── Island Configuration ──────────────────────────────────────────────────────
# Each island runs its own knowledge-service instance with isolated data
# ISLAND_ID determines collection names and log prefixes
ISLAND_ID=nexus
# PORT varies per island: nexus=3456, joinerytech=3458, doorstar=3460
PORT=3456
HOST=127.0.0.1

# Secure default. Configure at least MCP_AUTH_TOKEN (32+ random bytes) before
# using the API. Only local .env.dev should opt in to AUTH_MODE=open.
AUTH_MODE=required
# MCP_AUTH_TOKEN=
# ADMIN_SECRET=
# TERMINAL_TOKEN_SECRET=

# Comma-separated browser origins. Empty means same-origin only.
CORS_ORIGINS=
# Set only when the service is behind a trusted reverse proxy.
TRUST_PROXY_HOPS=0

# ── Data Paths (Multi-Island Isolation) ───────────────────────────────────────
# All paths default to relative locations within knowledge-service
# Override for island-specific deployment
# DATA_DIR=/opt/nexus/src/nexus-core/knowledge-service/data
# TERMINALS_PATH=/opt/nexus/terminals
# KNOWLEDGE_BASE_PATH=/opt/nexus/docs/knowledge
# LOGS_DIR=/opt/nexus/logs

# ── Embedding backend ────────────────────────────────────────────────────────
# Default: local all-MiniLM-L6-v2 (no API key needed, model downloads ~25MB on first run)
# Optional upgrade: set VOYAGE_API_KEY for voyage-3-lite (better semantic quality)
# Get key from: https://dash.voyageai.com/  (free tier available)
# VOYAGE_API_KEY=your_voyage_key_here

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# Start with: docker compose up -d
# Port 8001 avoids conflict with existing postgres (5432) and pgadmin (5050)
CHROMA_URL=http://localhost:8001
# Collection name auto-generated from ISLAND_ID, or override:
# COLLECTION_NAME=nexus-knowledge

# ── Knowledge graph (Neo4j, GraphRAG pilot) ──────────────────────────────────
# Unset GRAPH_URL disables every graph feature (fail-safe default).
# Server: docker/neo4j/ in the repo root (VPS: bolt://100.82.133.87:7687 over
# tailnet, localhost on the VPS itself). See docs/plans/GRAPHRAG-PILOT.md.
# Only bolt:// and neo4j:// URLs are accepted, and the password must NOT be
# embedded in the URL (connection URLs are logged) — use GRAPH_PASSWORD.
# GRAPH_URL=bolt://localhost:7687
# GRAPH_USER=neo4j
# GRAPH_PASSWORD=see docker/neo4j/.env on the host
# GRAPH_DATABASE=neo4j
# Client-side query timeout (ms, default 15000) — a deep traversal on a hub
# node must not pin the shared instance for every island.
# GRAPH_QUERY_TIMEOUT_MS=15000

# ── Nightwatch Scheduler ───────────────────────────────────────────────────────
# TypeScript replacement for bash cron pipeline
# Set to 'true' to enable built-in scheduler (replaces cron nightwatch.sh)
# ENABLE_NIGHTWATCH=true
# NIGHTWATCH_INTERVAL=120000

# ── Telegram (for notifications) ───────────────────────────────────────────────
# TELEGRAM_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# ── Autonomous Development ───────────────────────────────────────────────────────
# Enable autonomous development scheduler (cold-start Conductor every N minutes)
# ENABLE_AUTONOMOUS_DEV=true
# AUTONOMOUS_DEV_INTERVAL_MINUTES=20
# AUTONOMOUS_DEV_FOCUS_FILE=/opt/spaceos/docs/tasks/new/joinerytech/PROJECT_STATUS.md

# Token optimization (reduces prompt size by 30-50%)
# AUTONOMOUS_DEV_TOKEN_BUDGET=300
# AUTONOMOUS_DEV_INCLUDE_ARCHITECT_GUIDANCE=auto    # auto|always|never
# AUTONOMOUS_DEV_INCLUDE_MCP_EXAMPLES=first-3       # first-3|always|never
# AUTONOMOUS_DEV_INCLUDE_QUEUE_GUIDANCE=auto        # auto|always|never
# AUTONOMOUS_DEV_PROMPT_TEMPLATE=base               # base|verbose|minimal

# ══════════════════════════════════════════════════════════════════════════════
# TASK-QC-007 — Central config reference (appended 2026-07-18)
# Every env var below is read ONLY by src/config/env.ts / src/config/paths.ts.
# Defaults are platform independent: unset path vars derive from the checkout
# location (SPACEOS_ROOT = the directory containing knowledge-service).
# ══════════════════════════════════════════════════════════════════════════════

# ── Roots and trees (paths.ts) ────────────────────────────────────────────────
# Root of the SpaceOS tree (terminals/, docs/, config/, store/ live under it).
# Default: the checkout root. Deployments with a different layout MUST set it.
# SPACEOS_ROOT=/opt/spaceos
# EPICS_PATH=            # default: <SPACEOS_ROOT>/docs/projects/EPICS.yaml
# PROJECTS_DIR=          # default: <SPACEOS_ROOT>/docs/projects
# GOALS_DIR=             # default: <SPACEOS_ROOT>/store/goals
# IDEAS_DIR=             # default: <SPACEOS_ROOT>/docs/planning/ideas
# QUEUE_DIR=             # default: <SPACEOS_ROOT>/docs/planning/queue
# PLANNING_FOCUS_PATH=   # default: <SPACEOS_ROOT>/docs/planning/domain-focus.md
# CONDUCTOR_STATE_DIR=   # default: <SPACEOS_ROOT>/terminals/conductor
# WORKFLOWS_DIR=         # default: <SPACEOS_ROOT>/config/workflows
# TELEGRAM_BOTS_CONFIG=  # default: <SPACEOS_ROOT>/config/telegram-bots.yaml
# BACKEND_DIR=           # default: <SPACEOS_ROOT>/backend
# FRONTEND_PORTAL_PATH=frontend/portal   # relative to SPACEOS_ROOT
# DATAHAVEN_CLIENT_DIR=  # default: <SPACEOS_ROOT>/datahaven-web/client
# GENERATORS_DIR=        # default: <knowledge-service>/src/generators
# IDEA_SCAN_PROJECT_PATH=  # default: <SPACEOS_ROOT>/docs/tasks/new
# AUTONOMOUS_DEV_FOCUS_FILE=  # default: <SPACEOS_ROOT>/docs/tasks/new/PROJECT_STATUS.md
# TERMINALS_DIR=         # legacy alias of TERMINALS_PATH (kept for compat)

# ── Databases (default under DATA_DIR) ────────────────────────────────────────
# AGENT_MESSAGES_DB=     # default: <DATA_DIR>/agent_messages.db
# MESSAGE_REGISTRY_DB=   # default: <DATA_DIR>/message_registry.db
# REGISTRY_DB_PATH=      # legacy alias of MESSAGE_REGISTRY_DB
# DISPATCH_DB=           # default: <DATA_DIR>/dispatch.db
# MEMORY_DB=             # default: <DATA_DIR>/memory.db
# MEMORY_DB_PATH=        # legacy alias of MEMORY_DB
# WORKFLOW_DB=           # default: <DATA_DIR>/workflow.db
# TELEGRAM_DB_PATH=      # default: <DATA_DIR>/telegram.db
# GOLDEN_PATHS_DIR=      # default: <DATA_DIR>/golden-paths

# ── Service URLs (env.ts) ─────────────────────────────────────────────────────
# Base URL for the service's calls to ITSELF (watchers, digests, health).
# Default: http://127.0.0.1:<PORT> — correct for both DEV (3466) and PROD (3456).
# KNOWLEDGE_SERVICE_URL=
# CHROMADB_URL=          # legacy alias of CHROMA_URL (alias wins if both set)
# DATAHAVEN_URL=https://datahaven.joinerytech.hu
# DATAHAVEN_TOKEN=
# MARVEEN_URL=           # optional cross-island sync target
# MCP_SERVER_URL=        # default: <KNOWLEDGE_SERVICE_URL>/mcp
# MCP_DOCUMENTATION_URL=https://nexus.joinerytech.hu

# ── Background service flags (default: disabled unless noted) ─────────────────
# ENABLE_HEARTBEAT=true
# HEARTBEAT_INTERVAL=3600000
# ENABLE_AUTO_RESTART=true
# ENABLE_MESSAGE_ROUTER=true
# MESSAGE_ROUTER_INTERVAL=10000
# ENABLE_TELEGRAM_COORDINATOR=true
# ENABLE_ROOT_MONITOR=true
# ROOT_MONITOR_INTERVAL_MINUTES=60
# ENABLE_IDEA_SCAN=true
# IDEA_SCAN_INTERVAL_MINUTES=30
# IDEA_SCAN_MIN_INTERVAL=5
# IDEA_SCAN_MAX_INTERVAL=120
# ENABLE_HOURLY_DIGEST=true        # opt-out: enabled unless set to 'false'
# ENABLE_PHASE_COORDINATOR=true
# PHASE_COORDINATOR_INTERVAL_MINUTES=30
# ENABLE_MULTI_BOT=true
# METRICS_INTERVAL=60000

# ── Review pipeline ───────────────────────────────────────────────────────────
REVIEW_MODE=api                    # terminal | api; API avoids direct reviewer CLI launch
# PRE_REVIEW_ENABLED=true          # opt-out: enabled unless set to 'false'

# ── Conductor / autonomous dev tuning ─────────────────────────────────────────
# SPACEOS_MODE=                    # forces conductor operation mode
# AUTONOMOUS_DEV_CONTROL_MODE=autonomous   # manual | autonomous | hybrid

# ── Cost monitoring ───────────────────────────────────────────────────────────
# DAILY_COST_BUDGET=50             # USD

# ── Additional integrations / secrets (values managed per TASK-QC-003) ────────
# TELEGRAM_BOT_TOKEN=              # preferred; TELEGRAM_TOKEN is the legacy alias
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_URL=
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=                  # GEMINI_API_KEY is the legacy alias
# DASHBOARD_AUTH_TOKEN=
# RUNNER_TOKEN=                    # local runner identity (runner/runnerConfig.ts)
# RUNNER_CONFIG_PATH=              # default: <knowledge-service>/config/runner.yaml
