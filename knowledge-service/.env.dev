# NEXUS-DEV Environment
# Port 3466 - nem ütközik production-nel (3456)

NODE_ENV=development
PORT=3466

# Külön data mappa - nem piszkálja a prod adatokat
DATA_DIR=/opt/nexus-dev/knowledge-service/data

# Dev-specifikus logok
LOG_LEVEL=debug

# ChromaDB - ugyanazt használjuk (read-only jellegű)
CHROMA_HOST=http://localhost:8001

# Telegram KIKAPCSOLVA dev-ben (ne küldjön üzeneteket)
ENABLE_TELEGRAM_COORDINATOR=false
ENABLE_MULTI_BOT=false

# Automatikus pipeline-ok KIKAPCSOLVA
ENABLE_NIGHTWATCH=false
ENABLE_AUTO_RESTART=false
ENABLE_MESSAGE_ROUTER=false

# Inbox watcher KIKAPCSOLVA (ne indítson session-öket)
ENABLE_INBOX_WATCHER=false
