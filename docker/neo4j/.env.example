# Neo4j (GraphRAG) — a VALÓDI .env csak a VPS-en él, chmod 600, sosem gitre.
#
# Generálás:
#   openssl rand -base64 24
#
# Ugyanezt a jelszót kell a knowledge-service .env-jébe is beírni
# (GRAPH_PASSWORD), a GRAPH_URL pedig bolt://<tailnet-ip>:7687.
# FIGYELEM: ez az érték CSAK az első, üres /data volume-mal induló starton
# állítja be a jelszót — rotáció menete a docker-compose.yml fejlécében.
NEO4J_PASSWORD=changeme
