[Unit]
Description=JoineryTech provider-neutral Codex task runner
After=network-online.target spaceos-knowledge.service
Wants=network-online.target
Requires=spaceos-knowledge.service

[Service]
Type=simple
User=gabor
Group=gabor
WorkingDirectory=/opt/joinerytech/src/joinerytech-nexus/knowledge-service
Environment=HOME=/home/gabor
Environment=NODE_ENV=production
Environment=RUNNER_CONFIG_PATH=/opt/joinerytech/src/joinerytech-nexus/knowledge-service/config/runner.yaml
EnvironmentFile=/opt/joinerytech/src/joinerytech-nexus/knowledge-service/.env.runner
ExecStart=/usr/bin/node dist/runner/main.js
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/joinerytech /home/gabor/.codex
StandardOutput=append:/var/log/spaceos/codex-runner.log
StandardError=append:/var/log/spaceos/codex-runner.log

[Install]
WantedBy=multi-user.target
