node_modules/
dist/
data/
logs/

# Runtime env files — secrets never go to git; only *.example templates are tracked
.env
.env.*
!.env.example
!.env.*.example

# Auth tokens (secrets) — commit only the .example templates
**/config/agents.yaml
**/config/runner.yaml
# Host-specific graph corpora (e.g. a checkout that only exists on one machine)
**/config/*.local.yaml
*.db
*.db-shm
*.db-wal
.DS_Store

# Federation mailboxes (file-based, not Git)
**/terminals/*/inbox/
**/terminals/*/outbox/
**/terminals/*/archive/

# Local tool/test output logs at repo root
/*.log
