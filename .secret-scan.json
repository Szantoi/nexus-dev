{
  "$comment": "Configuration for scripts/secret-scan.mjs — local, dependency-free secret scanner. Patterns are ECMAScript regexes (applied per line, case-sensitive unless (?i)-style flags are inlined via 'flags').",
  "patterns": [
    {
      "id": "private-key-block",
      "description": "PEM/OpenSSH/PGP private key header",
      "regex": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY( BLOCK)?-----"
    },
    {
      "id": "aws-access-key-id",
      "description": "AWS access key id",
      "regex": "\\bAKIA[0-9A-Z]{16}\\b"
    },
    {
      "id": "github-token",
      "description": "GitHub classic/app tokens (ghp_, gho_, ghu_, ghs_, ghr_)",
      "regex": "\\bgh[pousr]_[A-Za-z0-9]{36,255}\\b"
    },
    {
      "id": "github-fine-grained-pat",
      "description": "GitHub fine-grained personal access token",
      "regex": "\\bgithub_pat_[A-Za-z0-9_]{80,}\\b"
    },
    {
      "id": "telegram-bot-token",
      "description": "Telegram bot token (bot_id:AA...)",
      "regex": "\\b[0-9]{8,10}:AA[A-Za-z0-9_-]{33}\\b"
    },
    {
      "id": "slack-token",
      "description": "Slack token (xoxb/xoxa/xoxp/xoxr/xoxs)",
      "regex": "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b"
    },
    {
      "id": "anthropic-api-key",
      "description": "Anthropic API key",
      "regex": "\\bsk-ant-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "openai-api-key",
      "description": "OpenAI project API key",
      "regex": "\\bsk-proj-[A-Za-z0-9_-]{20,}\\b"
    },
    {
      "id": "npm-token",
      "description": "npm automation token",
      "regex": "\\bnpm_[A-Za-z0-9]{36}\\b"
    },
    {
      "id": "jwt",
      "description": "JSON Web Token (three base64url segments)",
      "regex": "\\beyJ[A-Za-z0-9_-]{15,}\\.eyJ[A-Za-z0-9_-]{15,}\\.[A-Za-z0-9_-]{10,}"
    },
    {
      "id": "generic-secret-assignment",
      "description": "Quoted literal assigned to a password/secret/token-like key",
      "regex": "\\b(password|passwd|secret|api[_-]?key|auth[_-]?token|access[_-]?token|private[_-]?key)\\b\\s*[:=]\\s*[\"'][A-Za-z0-9+/_=-]{20,}[\"']",
      "flags": "i"
    }
  ],
  "allowedPaths": [
    "^docs/tasks/quality-compliance/TASK-QC-003-env-hygiene\\.md$",
    "^\\.secret-scan\\.json$",
    "^scripts/secret-scan\\.mjs$"
  ],
  "allowedLineMarker": "secret-scan:allow",
  "skipExtensions": [
    ".png", ".jpg", ".jpeg", ".gif", ".ico", ".pdf", ".zip", ".gz",
    ".woff", ".woff2", ".ttf", ".eot", ".mp3", ".mp4", ".db", ".sqlite"
  ]
}
